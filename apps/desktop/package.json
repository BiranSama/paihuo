{
  "name": "@paihuo/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --bundles nsis -- --locked",
    "web:dev": "vite",
    "web:build": "vite build",
    "prepare:runtime": "pnpm --filter @paihuo/core run build && node scripts/prepare-runtime.mjs",
    "prepare:dev": "pnpm run prepare:runtime && pnpm run web:dev",
    "prepare:build": "pnpm run prepare:runtime && pnpm run web:build && node scripts/generate-notices.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@paihuo/shared": "workspace:*",
    "@tauri-apps/api": "2.12.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "7.3.8"
  }
}
