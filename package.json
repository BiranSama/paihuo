{
  "name": "paihuo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @paihuo/desktop run dev",
    "build": "pnpm --filter @paihuo/desktop run build",
    "check": "biome ci . && pnpm -r run typecheck",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
